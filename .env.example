# ==============================================================================
# Immich DLNA Bridge Configuration
# ==============================================================================

# Required: URL to your Immich server (e.g. http://192.168.1.50:2283 or https://immich.local)
# Note: If no path is provided, /api is automatically appended.
IMMICH_URL=http://192.168.1.50:2283

# Required: Your Immich API Token (Generated in Immich Web UI -> Account Settings -> API Keys)
IMMICH_API_TOKEN=your_immich_api_key_here

# TLS verification for Immich upstream (set to false if using self-signed certs)
IMMICH_VERIFY_SSL=true

# DLNA device friendly name displayed on your Smart TV or DLNA client
IMMICH_DLNA_FRIENDLY_NAME=Immich

# Optional: UPnP device metadata displayed in Windows Network Device properties
# IMMICH_DLNA_MANUFACTURER=Immich DLNA Bridge
# IMMICH_DLNA_MANUFACTURER_URL=https://github.com/nicolasjweber/Immich-DLNA-Bridge
# IMMICH_DLNA_MODEL_NAME=Immich DLNA Bridge
# IMMICH_DLNA_MODEL_URL=https://github.com/nicolasjweber/Immich-DLNA-Bridge

# HTTP port for UPnP control, device descriptions, and media delivery
IMMICH_DLNA_HTTP_PORT=8200

# Base URL advertised to DLNA clients (e.g. http://192.168.1.60:8200)
# Leave empty to automatically detect your host LAN IP address.
IMMICH_DLNA_BASE_URL=

# Stable UUID for DLNA device. Leave empty to auto-generate a persistent UUID.
IMMICH_DLNA_SERVER_UUID=

# ==============================================================================
# Extended Browsing Features
# ==============================================================================

# Enable People / Persons browsing container (shows face thumbnails on TV)
IMMICH_DLNA_ENABLE_PEOPLE=true

# Show unnamed / unidentified faces in People list (default: false to keep TV UI clean)
IMMICH_DLNA_SHOW_UNNAMED_PEOPLE=false

# People sorting mode:
# - both: Shows two folders inside People: "Most Photos" (Immich standard) and "By Name (A-Z)"
# - photos: Lists people directly by photo count (Immich standard)
# - name: Lists people directly alphabetically (A-Z)
IMMICH_DLNA_PEOPLE_SORT=both

# Enable Albums container (browse owned and shared albums with album covers)
IMMICH_DLNA_ENABLE_ALBUMS=true

# Enable Favorites container (browse starred / favorite photos & videos)
IMMICH_DLNA_ENABLE_FAVORITES=true

# Enable Videos container (browse all video clips in Immich)
IMMICH_DLNA_ENABLE_VIDEOS=true

# Enable Tags container (browse photos organized by Immich tags)
IMMICH_DLNA_ENABLE_TAGS=true

# Tag grouping mode:
# - auto: Automatically group tags alphabetically into letter subfolders ("A", "B", ...)
#         when total tag count exceeds 100. This prevents hitting the 200-item view limit
#         imposed by Samsung Smart TVs and other TV DLNA clients where tags stop at letter "K".
#         Also provides "00. Alle Schlagwörter" to access all tags directly.
# - true: Always group tags by letter.
# - false: Always display a flat list of tags.
IMMICH_DLNA_TAGS_GROUP_BY_LETTER=auto

# Enable full flat Timeline container ("Zeitleiste (Alle Fotos)" with thousands of all photos)
# Default: false (Recommended: disabled for TVs because fetching tens of thousands of
# images in one flat folder is sluggish. Use the hierarchical "Zeitleiste" container instead!)
IMMICH_DLNA_ENABLE_TIMELINE=false

# Enable hierarchical Timeline container ("Zeitleiste" organized by Year & Month)
IMMICH_DLNA_ENABLE_YEARS=true

# Enable "00. Ganzes Jahr <year>" subfolder inside each year to view the whole year at once
IMMICH_DLNA_ENABLE_YEAR_ALL=true

# ==============================================================================
# Smart TV & Universal Client Compatibility
# ==============================================================================

# Image serving mode:
# - auto: Serves high-res JPEG previews for iPhone HEIC, camera RAW, and WebP,
#         while serving standard JPEG/PNG directly. Recommended for Smart TVs.
# - preview: Always serve high-resolution JPEG previews generated by Immich.
# - original: Always serve original uploaded files (may fail on TV for HEIC/RAW).
IMMICH_DLNA_IMAGE_QUALITY=auto

# Prefer JPEG for DLNA protocol advertisement (many Smart TVs require JPEG for photo playback)
IMMICH_DLNA_PREFER_JPEG=true

# Transcode WebP images to JPEG on the fly if Immich returns WebP format
IMMICH_DLNA_TRANSCODE_WEBP_TO_JPEG=true

# ==============================================================================
# Smart TV Sorting Order Preservation
# ==============================================================================
# Many Smart TVs (including Samsung Tizen, LG webOS, etc.) force alphabetical (A-Z)
# sorting on all folder contents. These options prefix items with zero-padded numbers
# so the TV naturally displays them in the intended Immich order:
# popularity for people, newest first for photos and years.

# Prefix people in "Meiste Fotos" with popularity rank (e.g. "01. Alice", "02. Bob")
IMMICH_DLNA_NUMBER_PEOPLE=true

# Prefix years with descending index so newest year appears first on TV (e.g. "01. 2026", "02. 2025")
IMMICH_DLNA_NUMBER_YEARS=true

# Prefix photos and videos with index so newest photos appear first on TV (e.g. "001. IMG_001.jpg")
IMMICH_DLNA_NUMBER_ASSETS=true

# Title format for photos & videos:
# - index_filename: "001. IMG_0001.jpg" (Recommended)
# - index_date_filename: "001. 2024-05-12 - IMG_0001.jpg"
# - raw: "IMG_0001.jpg" (No prefix numbering)
IMMICH_DLNA_ASSET_TITLE_FORMAT=index_filename

# Logging level (DEBUG, INFO, WARNING, ERROR)
IMMICH_DLNA_LOG_LEVEL=INFO
